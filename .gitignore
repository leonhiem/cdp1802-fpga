# Vivado batch-mode journal/log/webtalk files land wherever vivado was
# launched from -- the actual project lives outside this repo (see
# boards/*/build_project.tcl), so these are always stray here.
vivado.jou
vivado.log
vivado_*.backup.jou
vivado_*.backup.log
vivado_pid*.str
webtalk*.jou
webtalk*.log
.Xil/
.srcs/

# Third-party copyrighted material (vendor schematics, ROM dumps) --
# this repo is public, so these stay local-only. See
# doc/CS1800_HARDWARE.md for the documentation derived from them.
doc/cs1800_hardware_source/
